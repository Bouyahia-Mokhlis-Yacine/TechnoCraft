# Optional local language model for the assistant (see ../llm/README.md). Leave LLM_URL unset
# to use only the deterministic assistant. Open the tunnel first: ../llm/tunnel.sh
# LLM_URL=http://127.0.0.1:18000/v1
LLM_MODEL=assistant
LLM_TIMEOUT_MS=12000
# RUNS_DIR=C:/path/to/website/runs
# PDF_CHROMIUM=C:/Program Files/Google/Chrome/Application/chrome.exe
# PDF_ORIGIN=http://127.0.0.1:3000
# LIVE_MONITORING_URL=http://127.0.0.1:8765
# LIVE_MONITORING_TOKEN=<same random server secret as the local Python replay service>
